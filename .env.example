# Copy to .env. Use a unique password of at least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
PORT=5173
# Optional MongoDB storage (one local application instance only)
MONGO_URI=
MONGO_DB=prakshal_connect

# Cloud API: keep disabled until authorized testing and production hardening
WA_LIVE_ENABLED=false
WA_GRAPH_VERSION=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=
