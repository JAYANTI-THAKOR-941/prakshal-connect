{
  "name": "prakshal-connect",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
