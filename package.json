    "test": "node --test",
    "install:check": "node scripts/check-install.mjs",
    "start:local": "node --env-file-if-exists=.env scripts/start-local.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongodb": "^6.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "vite": "^6.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0"
  }
}
